{
  "engine_key": "postnava_ventocr",
  "display_name": "PostNAVA",
  "developer": "VentOCR Developer Team",
  "version": "0.2.0",
  "ventocr_min": "0.6.2",
  "engine_api": 3,
  "description": "Servo-U Edi monitor screen (e.g. after NAVA / standby). OCR: Edipeak, Edimin. Breath = Edimin display update (neural inspiration onset). Waveform: Edi with wrap-around sweep (about 164 px/s, 5.4 s per sweep on 1280x720).",

  "sample_video": "PostNAVA_VentOCR_sample.mp4",
  "base_resolution": "1280x720",
  "supported_resolutions": ["1280x720"],

  "has_extract_waves": true,
  "output_columns": {
    "frames": ["Frame", "EdiPeak", "Edimin", "EdiPeak_Update", "Edimin_Update", "Sweep_X", "BreathMark", "BreathNumber", "Abnormal"],
    "breaths": ["BreathNumber", "EdiPeak", "Edimin", "Edimin_displayed", "Duration", "Wave_Max", "Wave_Min", "Clipped_Points", "Alert"],
    "waves": ["X", "Edi"]
  },

  "breath_summary": ["EdiPeak", "Edimin", "Edimin_displayed", "Wave_Max", "Clipped_Points"],
  "labels": {
    "Edimin_displayed": "Edimin (displayed)",
    "Wave_Max": "Edi max (waveform)",
    "Clipped_Points": "Clipped points"
  },

  "outputs": {
    "waves": [
      { "name": "Edi", "unit": "µV", "color": "#9467bd", "scale": { "min": "E_min", "max": "E_max" } }
    ],
    "breath_values": [
      { "name": "EdiPeak",          "label": "EdiPeak",            "unit": "µV" },
      { "name": "Edimin",           "label": "Edimin",             "unit": "µV" },
      { "name": "Edimin_displayed", "label": "Edimin (displayed)", "unit": "µV" },
      { "name": "Wave_Max",         "label": "Edi max (waveform)", "unit": "µV" },
      { "name": "Clipped_Points",   "label": "Clipped points" }
    ],
    "alerts": [
      { "name": "Fragment",         "label": { "ja": "録画の最初・最後で途中から始まる・切れている呼吸", "en": "Cut at the start or end of the recording" }, "exclude_from_accuracy": true },
      { "name": "ScaleChanged",     "label": { "ja": "呼吸の途中で Edi の縦軸の上限が変わった（波形は出さない）", "en": "Edi axis range changed during the breath (no waveform)" }, "exclude_from_accuracy": true },
      { "name": "Abnormal",         "label": { "ja": "Edi モニタ以外の画面・ポップアップのフレームを含む", "en": "Contains frames of another screen or a popup" }, "exclude_from_accuracy": true },
      { "name": "OnsetEstimated",   "label": { "ja": "Edimin の表示の更新が見えず、呼吸の始まりを推定した", "en": "Edimin update not seen; breath onset estimated" }, "exclude_from_accuracy": false },
      { "name": "NoBreathDetected", "label": { "ja": "呼吸器が呼吸を検出しなかった（Edipeak が「***」）", "en": "The ventilator detected no breath (Edipeak \"***\")" }, "exclude_from_accuracy": true },
      { "name": "Clipped",          "label": { "ja": "波形が縦軸の上限を超えて切れている", "en": "Waveform clipped at the top of the axis" }, "exclude_from_accuracy": true }
    ]
  },

  "accuracy": {
    "EdiPeak":          { "method": null, "threshold": null, "unit": "µV" },
    "Edimin":           { "method": null, "threshold": null, "unit": "µV" },
    "Edimin_displayed": { "method": null, "threshold": null, "unit": "µV" },
    "Wave_Max":         { "method": null, "threshold": null, "unit": "µV" },
    "Wave_Min":         { "method": null, "threshold": null, "unit": "µV" },
    "BreathMark":       { "method": null, "threshold": null }
  }
}
